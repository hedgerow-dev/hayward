{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hedgerow-dev/hayward",
  "description": "Checks ML model files (pickle, PyTorch, joblib, NumPy, GGUF, ONNX) for code that runs on load.",
  "repository": {
    "url": "https://github.com/hedgerow-dev/hayward",
    "source": "github"
  },
  "version": "1.5.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "hayward",
      "version": "1.5.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--with",
          "value": "mcp>=2.3,<3"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
